@if (Href is null)
{
    <div class="td-kpi @Variante">@Contenido</div>
}
else
{
    <a class="td-kpi @Variante" href="@Href">@Contenido</a>
}

@code {
    [Parameter] public string Icono { get; set; } = "bi-graph-up";
    [Parameter] public string Etiqueta { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = "0";
    [Parameter] public string? Detalle { get; set; }
    /// <summary>Vacío (blanco), "negro" o "amarillo".</summary>
    [Parameter] public string Variante { get; set; } = string.Empty;
    [Parameter] public string? Href { get; set; }

    private RenderFragment Contenido => __builder =>
    {
        <div class="d-flex justify-content-between align-items-start">
            <div class="td-kpi-icono"><i class="bi @Icono"></i></div>
            @if (Href is not null)
            {
                <i class="bi bi-arrow-up-right opacity-50"></i>
            }
        </div>
        <div class="td-kpi-valor mt-2">@Valor</div>
        <div class="td-kpi-etiqueta">@Etiqueta</div>
        @if (Detalle is not null)
        {
            <div class="td-kpi-detalle">@Detalle</div>
        }
    };
}
